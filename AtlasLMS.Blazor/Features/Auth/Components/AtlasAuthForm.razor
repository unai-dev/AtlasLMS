<div class="atlas-auth-page d-flex justify-content-center align-items-center">

    <div class="card shadow-lg p-5 auth-card">
        <EditForm EditContext="@editContext" OnValidSubmit="HandleValidSubmit">

            <DataAnnotationsValidator />

            <h3 class="text-center mb-4 text-primary">¡Bienvenido a AtlasLMS!</h3>

            <label class="form-label">Email</label>
            <InputText type="email" @bind-Value="@User.Email" placeholder="unai@gmail.com" class="form-control mb-3" />

            <label class="form-label">Contraseña</label>
            <div class="position-relative mb-3">
                <InputText type="@(hidePassword ? "password" : "text")"
                           @bind-Value="@User.Password"
                           placeholder="·············"  
                           class="form-control" />

                <i @onclick="TooglePassword"
                   class="@(hidePassword ? "bi bi-eye-fill" : "bi bi-eye-slash-fill") position-absolute top-50 translate-middle-y"
                   style="right: 12px; cursor: pointer; font-size: 1.2rem;">
                </i>
            </div>

            <div class="text-end mb-1">
                <a href="#" class="text-decoration-none text-primary small">¿Olvidaste tu contraseña?</a>
            </div>

            <button class="btn btn-primary w-100" disabled="@CurrentPost">
                @(CurrentPost ? "Iniciando Sesión..." : "Iniciar Sesión")
            </button>

            <footer class="text-center mt-3 text-muted small">
                © 2026 AtlasLMS - Software de Gestión de Librerías
            </footer>
        </EditForm>
    </div>

</div>

@code {
    #region     Parameters--------------------------------------------
    [Parameter, EditorRequired] public LoginDto User { get; set; }
    [Parameter, EditorRequired] public EventCallback OnSubmit { get; set; }
    [Parameter, EditorRequired] public bool CurrentPost { get; set; }
    #endregion

    private EditContext? editContext;
    private bool hidePassword = true;

    protected override void OnInitialized() => editContext = new EditContext(User);
    private void TooglePassword() => hidePassword = !hidePassword;

    private async Task HandleValidSubmit()
    {
        if (editContext is not null && editContext.Validate())
            await OnSubmit.InvokeAsync();
    }

}
