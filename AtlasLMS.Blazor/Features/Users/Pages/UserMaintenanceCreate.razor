@page "/users/create"
@attribute [Authorize]

<PageTitle>Matenimiento de usuarios</PageTitle>
<AtlasForm CaptionMaintenance="usuarios"
           TModel="UserCreateDto"
           Model="user"
           CurrentPost="currentPost"
           OnCancel="HandleCancelUser"
           OnSave="HandleSaveUser">

    <label class="form-label">Email</label>
    <InputText type="email" @bind-Value="@user.Email" placeholder="Introduce el email" class="form-control mb-3" />

    <label class="form-label">Nombre de usuario</label>
    <InputText @bind-Value="@user.UserName" placeholder="Introduce el nombre de usuario" class="form-control mb-3" maxlength="55" />

    <label class="form-label">CIF</label>
    <InputText @bind-Value="@user.CIF" placeholder="Introduce el CIF" class="form-control mb-3" maxlength="9" />

    <label class="form-label">Contraseña</label>
    <PasswordInput @bind-Value="@user.Password" placeholder="Introduce la contraseña" />

</AtlasForm>
