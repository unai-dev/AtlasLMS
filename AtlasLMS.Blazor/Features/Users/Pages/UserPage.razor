@page "/users/{ID}"

<PageTitle>Detalles de usuario</PageTitle>

@if (isLoading)
{
    <AtlasLoadingSpinner />
}
else if (user is not null)
{
    <div class="container mt-4">

        <!-- Header -->
        <AtlasDetailHeader HeaderText=@($"Detalles de {user.UserName}") OnReturn="HandleReturn" />

        <!-- Card principal -->
        <Card Class="shadow-sm border-0 rounded-3 bg-light">
            <CardBody Class="p-4">
                <div class="row">
                    <div class="col-md-3 text-center">
                        <div class="bg-danger bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mx-auto"
                             style="width:100px; height:100px;">
                            <span class="fw-bold text-danger fs-1">
                                @(user.UserName.FirstOrDefault().ToString().ToUpper())
                            </span>
                        </div>
                    </div>

                    <div class="col-md-9">
                        <p><strong>ID:</strong> @user.ID</p>
                        <p><strong>Usuario:</strong> @user.UserName</p>
                        <p><strong>Email:</strong> @user.Email</p>
                        <p><strong>CIF:</strong> @user.CIF</p>
                        <p>
                            <strong>Estado:</strong>
                            <Badge Color="@(user.IsActive ? BadgeColor.Success : BadgeColor.Secondary)" Class="px-3 py-2">
                                @(user.IsActive ? "Activo" : "Inactivo")
                            </Badge>
                        </p>
                        <p><strong>Fecha de alta:</strong> @user.CreatedAt.ToString("d")</p>

                        @if (user.UpdatedAt.HasValue)
                        {
                            <p>
                                <strong>Última actualización:</strong>
                                @user.UpdatedAt.Value.ToString("d");
                            </p>
                        }
                    </div>
                </div>
            </CardBody>
        </Card>

        <!-- Tabs -->
        @* <Tabs Class="mt-4">
                <Tab Title="Préstamos">
                    <LoanList Items="@User.Loans" />
                </Tab>
                <Tab Title="Reservas">
                    <BookingList Items="@User.Bookings" />
                </Tab>
            </Tabs> *@
    </div>
}
else
{
    <AtlasDetailNotData />
}