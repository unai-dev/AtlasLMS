@page "/users"
@attribute [Authorize]

<PageTitle>Usuarios</PageTitle>

<ConfirmDialog @ref="dialog" />
<div class="container mt-4">

    <AtlasGridHeader Title="Gestión de Usuarios" ButtonCaption="Nuevo usuario" OnNew="HandleNewUser"/>

    <div class="col-9 w-100">
        <div class="card shadow-sm">
            <div class="card-body">

                <table class="table table-bordered table-striped table-responsive">
                    <thead class="table-light">
                        <tr>
                            <th>Avatar</th>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th>Fecha alta</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    @if (isLoading)
                    {
                        <Spinner Type="SpinnerType.Dots" Color="SpinnerColor.Primary" Size="SpinnerSize.Large" />
                    }
                    else
                    {
                        <tbody>
                            @foreach (var user in users)
                            {
                                <UserItem User="@user" OnDelete="() => HandleDeleteUser(user.ID)" OnView="() => HandleViewUser(user.ID)" />
                            }
                        </tbody>
                    }

                </table>
                <AtlasGridPagination />
            </div>
        </div>
    </div>
</div>