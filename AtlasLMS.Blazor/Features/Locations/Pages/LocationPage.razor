@page "/locations/{ID:int}"

<PageTitle>Detalles de ubicación</PageTitle>

@if (isLoading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 200px;">
        <Spinner Type="SpinnerType.Dots" Size="SpinnerSize.Large" Color="SpinnerColor.Danger" />
    </div>
}
else if (location is not null)
{
    <div class="container mt-4">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="fw-bold text-danger">Detalles de @location.Location</h3>
            <button class="btn btn-danger px-3" @onclick="HandleReturn">
                <Icon Name="IconName.ArrowLeft" Color="IconColor.Light" Class="me-1" />
                Volver
            </button>
        </div>

        <!-- Card principal -->
        <Card Class="shadow-sm border-0 rounded-3 bg-light">
            <CardBody Class="p-4">
                <div class="row">
                    <div class="col-md-9">
                        <p><strong>ID:</strong> @location.ID</p>
                        <p><strong>Ubicación:</strong> @location.Location</p>
                        <p><strong>Pasillo:</strong> @location.Aisle</p>
                        <p><strong>Columna:</strong> @location.Column</p>
                        <p><strong>Estante:</strong> @location.Shelf</p>
                        <p><strong>Limite de libros:</strong> @location.LimitOfBooks</p>
                        <p>
                            <strong>Estado:</strong>
                            <Badge Color="@(location.IsActive ? BadgeColor.Success : BadgeColor.Secondary)" Class="px-3 py-2">
                                @(location.IsActive ? "Activo" : "Inactivo")
                            </Badge>
                        </p>
                        <p><strong>Fecha de alta:</strong> @location.CreatedAt.ToString("d")</p>

                        @if (location.UpdatedAt.HasValue)
                        {
                            <p>
                                <strong>Última actualización:</strong>
                                @location.UpdatedAt.Value.ToString("d");
                            </p>
                        }
                    </div>
                </div>
            </CardBody>
        </Card>

        <!-- Tabs -->
        @* <Tabs Class="mt-4">
                <Tab Title="Libros">
                    <Libro Items="@author.Books" />
                </Tab>
            </Tabs> *@
    </div>
}
else
{
    <div class="text-center py-4">
        <Icon Name="IconName.ExclamationTriangle" Class="display-6 text-warning mb-2" />
        <p class="text-muted">Datos no disponibles</p>
    </div>
}