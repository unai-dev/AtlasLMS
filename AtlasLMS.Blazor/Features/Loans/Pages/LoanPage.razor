@page "/loans/{ID:int}"

<PageTitle>Detalles de prestamos</PageTitle>


@if (isLoading)
{
    <AtlasLoadingSpinner />
}
else if (loan is not null)
{
    <div class="container mt-4">

        <!-- Header -->
        <AtlasDetailHeader HeaderText="Detalles de prestamo" OnReturn="HandleReturn" />

        <!-- Card principal -->
        <Card Class="shadow-sm border-0 rounded-3 bg-light">
            <CardBody Class="p-4">
                <div class="row">

                    <div class="col-md-9">
                        <p><strong>ID:</strong> @loan.ID</p>
                        <p><strong>Fecha de inicio:</strong> @loan.StartDate</p>
                        <p><strong>Fecha de recogida:</strong> @loan.DueDate</p>
                        <p class="link-primary" style="cursor:pointer;" @onclick="() => HandleViewUser(loan.UserID)"><strong>Usuario:</strong> @loan.UserID</p>
                        <p class="link-primary" style="cursor:pointer;" @onclick="() => HandleViewBook(loan.BookID)"><strong>Libro:</strong> @loan.BookID</p>
                        <p>
                            <strong>Estado:</strong>
                            <Badge Color="@(loan.Status == 2 ? BadgeColor.Success : BadgeColor.Danger)" Class="px-3 py-2">
                                @(loan.Status == 2 ? "Activo" : "Expirado/Cancelado")
                            </Badge>
                        </p>
                        <p><strong>Fecha de alta:</strong> @loan.CreatedAt.ToString("d")</p>
                    </div>
                </div>
            </CardBody>
        </Card>
    </div>
}
else
{
    <AtlasDetailNotData />
}