@page "/bookings/create"
@attribute [Authorize]

<PageTitle>Mantenimiento de reservas</PageTitle>

<AtlasForm TModel="BookingCreateDto"
           CaptionMaintenance="reservas"
           CurrentPost="currentPost"
           Model="booking"
           OnSave="HandleSaveBooking"
           OnCancel="HandleCancel">

    <label class="form-label">Fecha de inicio</label>
    <InputDate class="form-control mb-3" @bind-Value="booking.StartTime" />

    <label class="form-label">Libro</label>
    <InputSelect class="form-select mb-3" @bind-Value="booking.BookID">
        <option value="">Seleciona un libro</option>
        @foreach (BookReadDto book in books)
        {
            <option value="@book.ID">@book.Title</option>
        }
    </InputSelect>

    <label class="form-label">Usuario</label>
    <InputSelect class="form-select mb-3" @bind-Value="booking.UserID">
        <option value="">Seleciona un usuario</option>
        @foreach (UserReadDto user in users)
        {
            <option value="@user.ID">@user.Email</option>
        }
    </InputSelect>

</AtlasForm>
