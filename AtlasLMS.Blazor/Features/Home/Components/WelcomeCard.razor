<Card Class="shadow-sm border-0 rounded-3 atlas-welcome-card bg-light">
    <CardBody Class="p-4">
        @if (IsLoading)
        {
            <div class="d-flex justify-content-center align-items-center" style="height: 120px;">
                <Spinner Type="SpinnerType.Dots" Size="SpinnerSize.Large" Color="SpinnerColor.Primary" />
            </div>
        }
        else if (User is not null)
        {
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="fw-semibold text-primary mb-1">
                        Bienvenido, <span class="text-dark">@User.UserName</span>
                    </h4>
                    <p class="text-muted mb-2 small">
                        Fecha de alta: @User.CreatedAt.ToString("d")
                    </p>

                    <Badge Color="BadgeColor.Success" Class="px-3 py-2">
                        @(User.IsActive ? "Activo" : "Inactivo")
                    </Badge>
                </div>

                <div class="text-end">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width:64px; height:64px;">
                        <span class="fw-bold text-primary fs-4">
                            @(User.UserName?.FirstOrDefault().ToString().ToUpper())
                        </span>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center py-4">
                <Icon Name="IconName.ExclamationTriangle" Class="display-6 text-warning mb-2" />
                <p class="text-muted">Datos no disponibles</p>
            </div>
        }
    </CardBody>
</Card>
