<Card Class="shadow-sm border-0 rounded-2 atlas-welcome-card">
    <CardBody>
        @if (IsLoading)
        {
            <Spinner Type="SpinnerType.Dots" Size="SpinnerSize.Large" Color="SpinnerColor.Primary" />
        }
        else if (User is not null)
        {
            <div class="row align-items-center">
                <div class="col">
                    <h3 class="fw-bold text-primary mb-1">Bienvenido, @User.UserName</h3>
                    <p class="text-muted mb-2">
                        Fecha de alta: @User.CreatedAt.ToString("d")
                    </p>

                    <Badge Color="BadgeColor.Primary" Class="me-2">@User.IsActive</Badge>
                </div>

                <div class="col-auto text-end">
                    <Icon Name="IconName.BookHalf" class="display-4 text-primary" />
                </div>
            </div>
        }
        else
        {
            <h1>Datos no disponibles</h1>
        }
    </CardBody>
</Card>


@code {
    #region Parameters---------------------------------------------------------------
    [Parameter, EditorRequired] public bool IsLoading { get; set; }
    [Parameter, EditorRequired] public UserReadDto User { get; set; }
    #endregion
}
