<nav class="sidebar @(hidden ? "collapsed" : "") fixed-top mt-5">
    <div class="sidebar-header">
        <button class="navbar-toggle btn btn-link text-white position-fixed top-0 start-0 mt-2 ms-2" @onclick="ToogleHidden">
            <i class="bi bi-list fs-4"></i>
        </button>
    </div>
    
    <div class="sidebar-content">
        <ul class="menu">
            <li>
                <NavLink href="/" class="nav-item" activeClass="active">
                    <Icon Name="IconName.HouseFill" Color="IconColor.Warning" Size="IconSize.x4" />
                    <span class="@(hidden ? "d-none": "d-block")">Inicio</span>
                </NavLink>
            </li>

            <li>
                <NavLink href="/reservations" class="nav-item" activeClass="active">
                    <Icon Name="IconName.CalendarFill" Color="IconColor.Success" Size="IconSize.x4" />
                    <span class="@(hidden ? "d-none" : "d-block")">Reservas</span>
                </NavLink>
            </li>
            
            <li>
                <NavLink href="/users" class="nav-item" activeClass="active">
                    <Icon Name="IconName.PeopleFill" Color="IconColor.Primary" Size="IconSize.x4" />
                    <span class="@(hidden ? "d-none" : "d-block")">Usuarios</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="/authors" class="nav-item" activeClass="active">
                    <Icon Name="IconName.Feather" Color="IconColor.Danger" Size="IconSize.x4" />
                    <span class="@(hidden ? "d-none" : "d-block")">Autores</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="/locations" class="nav-item" activeClass="active">
                    <Icon Name="IconName.MapFill" Color="IconColor.Warning" Size="IconSize.x4" />
                    <span class="@(hidden ? "d-none" : "d-block")">Ubicaciones</span>
                </NavLink>
            </li>
        </ul>
    </div>

</nav>


@code {
    private bool hidden = false;

    private void ToogleHidden() => hidden = !hidden;
}