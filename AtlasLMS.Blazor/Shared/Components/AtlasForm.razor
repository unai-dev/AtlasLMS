@typeparam TModel

<div class="container atlas-form">
    <div class="card border-0">
        <div class="card-header text-white fw-semibold">
            Mantenimiento de @CaptionMaintenance
        </div>

            <EditForm EditContext="@editContext" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                <div class="m-4">
                    @ChildContent
                </div>

                <div class="d-flex justify-content-end mx-4 mb-3">
                    <button class="btn btn-success" type="submit" disabled="@CurrentPost" >Guardar</button>
                    <button class="btn btn-secondary ms-2" @onclick="() => OnCancel.InvokeAsync()">Cancelar</button>
                </div>
            </EditForm>
    </div>
</div>