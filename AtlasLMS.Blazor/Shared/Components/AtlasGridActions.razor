<button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => OnView.InvokeAsync(ID)">
    <Icon Name="IconName.Eye" />
</button>
<button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OnEdit.InvokeAsync(ID)">
    <Icon Name="IconName.Pencil" />
</button>
<button class="btn btn-sm btn-outline-danger" @onclick="() => OnDelete.InvokeAsync(ID)">
    <Icon Name="IconName.Trash" />
</button>

@code {
    #region Parameters-----------------------------------------
    [Parameter] public int ID { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
    [Parameter] public EventCallback<int> OnView { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }
    #endregion
}
